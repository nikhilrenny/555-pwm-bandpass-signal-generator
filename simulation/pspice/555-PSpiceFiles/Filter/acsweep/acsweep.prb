[DISPLAYS]
BEGIN DISPLAY LAST SESSION
ANALYSIS AC_SWEEP
SYMBOL ALWAYS
TRACECOLORSCHEME NORMAL
BEGIN ANAPLOT 1
ACTIVE
XBASE
BEGIN XAXIS
XAXISUSERNAME 0 (null)
TEXT Frequency
RANGEFLAG AUTO
TYPE LOG
UNIT H
BEGIN GRIDS
AUTOMATIC
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
END XAXIS
BEGIN YAXIS 1
YAXISSIDE LEFT
ACTIVE
RANGEFLAG AUTO
TYPE LINEAR
UNIT V
BEGIN GRIDS
AUTOMATIC
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
BEGIN TRACE V(U14:OUT)
MARKERID 99
TRACEADDEXT
END TRACE V(U14:OUT)
BEGIN TRACE V(U12:+)
MARKERID 101
TRACEADDEXT
END TRACE V(U12:+)
END YAXIS 1
END ANAPLOT 1
END DISPLAY LAST SESSION
[MEASUREMENTS]
AC 0 Bandwidth_Bandpass_3dB(V(U11:OUT))
AC 0 Bandwidth(V(U10:OUT),40)
AC 0 Bandwidth(V(U11:OUT),40)
AC 0 CenterFrequency(V(U11:OUT),3)
AC 0 Bandwidth_Bandpass_3dB(V(U10:OUT))
AC 0 Bandwidth_Bandpass_3dB(V(U13:OUT))
AC 0 Bandwidth(V(U13:OUT),40)
