[DISPLAYS]
BEGIN DISPLAY LAST SESSION
ANALYSIS TRANSIENT_ANALYSIS
SYMBOL ALWAYS
TRACECOLORSCHEME NORMAL
BEGIN ANAPLOT 1
ACTIVE
XBASE
BEGIN XAXIS
XAXISUSERNAME 0 (null)
TEXT Time
RANGEFLAG AUTO
TYPE LOG
UNIT s
BEGIN GRIDS
AUTOMATIC
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
END XAXIS
BEGIN YAXIS 1
YAXISSIDE LEFT
ACTIVE
RANGEFLAG AUTO
TYPE LINEAR
UNIT V
BEGIN GRIDS
AUTOMATIC
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
BEGIN TRACE V(U15:+)
MARKERID 30
TRACEADDEXT
END TRACE V(U15:+)
BEGIN TRACE V(C1:2)
MARKERID 42
TRACEADDEXT
END TRACE V(C1:2)
END YAXIS 1
END ANAPLOT 1
BEGIN MEASUREMENTS
SIZE 97
MEASNAMECOLWIDTH 210
BEGIN MEASUREMENT 1
NAME Max(V(U14:OUT))
EVALUATE 1
END MEASUREMENT 1
BEGIN MEASUREMENT 2
NAME Max(V(U16:OUT))
EVALUATE 1
END MEASUREMENT 2
BEGIN MEASUREMENT 3
NAME Max(V(U15:OUT))
EVALUATE 1
END MEASUREMENT 3
END MEASUREMENTS
END DISPLAY LAST SESSION
[MEASUREMENTS]
TR 0 Max(V(U14:OUT))
TR 0 Max(V(U16:OUT))
TR 0 Max(V(U15:OUT))
